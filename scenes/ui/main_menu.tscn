[node name="ObjectiveTitle" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.827451, 0.247059, 1)
theme_override_font_sizes/font_size = 14
text = "OBJETIVO"

[node name="ObjectiveText" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
custom_minimum_size = Vector2(700, 0)
theme_override_colors/font_color = Color(0.87, 0.93, 1, 1)
theme_override_font_sizes/font_size = 12
text = "Completa todos los niveles en el menor tiempo posible: llega al portal de cada uno esquivando enemigos y obstáculos. Al morir reapareces en el último control (bandera) con una vida menos."
autowrap_mode = 3

[node name="ObjectsTitle" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.827451, 0.247059, 1)
theme_override_font_sizes/font_size = 14
text = "OBJETOS DEL NIVEL"

[node name="ObjectsText" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
custom_minimum_size = Vector2(700, 0)
theme_override_colors/font_color = Color(0.87, 0.93, 1, 1)
theme_override_font_sizes/font_size = 12
text = "Hierba curativa: recupera un punto de vida.
Control (bandera): guarda el punto de reaparición y recupera toda la vida.
Portal de salida: completa el nivel y pasa al siguiente.
Plataformas móviles, sierras y pinchos: obstáculos; los pinchos y los pozos cuestan un golpe.
Enemigos: no puedes atacarlos, esquívalos saltando. El mago lanza 3 bolas de fuego, el arquero una flecha rápida y los voladores cruzan la pantalla ondulando. En el nivel 7 el mundo está invertido y los enemigos llevan sombrero triangular amarillo. En el nivel 8 el recorrido del nivel 2 va en espejo y los controles horizontales están invertidos."
autowrap_mode = 3

[node name="TimeTitle" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.827451, 0.247059, 1)
theme_override_font_sizes/font_size = 14
text = "TIEMPO"

[node name="TimeText" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
custom_minimum_size = Vector2(700, 0)
theme_override_colors/font_color = Color(0.87, 0.93, 1, 1)
theme_override_font_sizes/font_size = 12
text = "Todos los niveles jugables tienen 70 segundos; la hoja de ruta prevé 40. El reloj sigue corriendo al morir y no regala tiempo. Termina antes de 35 s para oro, 50 s para plata y 70 s para bronce. Bajo 10 s el tiempo se muestra en rojo."
autowrap_mode = 3

[node name="ItemsTitle" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.827451, 0.247059, 1)
theme_override_font_sizes/font_size = 14
text = "HABILIDADES Y VIDAS"

[node name="ItemsText" type="Label" parent="InstructionsPanel/PanelMargin/VBox/Scroll/Content"]
layout_mode = 2
custom_minimum_size = Vector2(700, 0)
theme_override_colors/font_color = Color(0.87, 0.93, 1, 1)
theme_override_font_sizes/font_size = 12
text = "Vidas: tienes 3 por nivel; al morir reapareces en el último control con la cuenta regresiva reiniciada. Si se agotan, eliges repetir el nivel o volver a empezar la zona.
Correr: el personaje corre siempre por defecto.
Doble salto: disponible siempre en el aire; pulsa saltar otra vez para impulsarte.
Impulso: pulsa Ctrl para lanzarte rápido hacia delante; no cuenta como salto y mientras dura atraviesas enemigos y proyectiles sin recibir daño (las trampas sí hacen daño).
Caer rápido: mantén Abajo o S en el aire para caer al instante."
autowrap_mode = 3

